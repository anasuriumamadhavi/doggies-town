# .env.example

# Copy this to backend/.env (or frontend/.env) for local development. DO NOT commit real credentials.

# For local development you can use a local MongoDB instance:
# MONGO_URL="mongodb://localhost:27017"
# DB_NAME="test_database"
# CORS_ORIGINS="*"

# For production/preview deployments on Vercel, replace MONGO_URL with a cloud-accessible MongoDB URI (Atlas, etc.).
# Example Atlas URI (replace <user>, <password>, <cluster>, <dbname>):
# MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"
# DB_NAME="your_database_name"
# CORS_ORIGINS="https://your-domain.com"
